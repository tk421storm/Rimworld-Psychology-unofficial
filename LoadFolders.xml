<?xml version="1.0" encoding="utf-8"?>
<!--
  Folder layout
    Common/                      Defs, Patches, Languages and Textures shared by every supported game version
    Common/Mods/<Mod>/           XML that only loads when <Mod> is active
    <version>/Assemblies/        Psychology.dll built for that game version (Source/, -p:RimWorldVersion=<version>)
    <version>/Mods/<Mod>/        optional compatibility assemblies, loaded only when <Mod> is active

  If a game version ever needs different XML, add <version>/Defs or <version>/Patches next to its Assemblies;
  later folders in a list override earlier ones.
-->
<loadFolders>
	<v1.6>
		<li>Common</li>
		<li>1.6</li>
		<li IfModActive="Ludeon.RimWorld.Ideology">Common/Mods/Ideology</li>
		<li IfModActive="erdelf.HumanoidAlienRaces">Common/Mods/HumanoidAlienRaces</li>
		<li IfModActive="erdelf.HumanoidAlienRaces">1.6/Mods/HumanoidAlienRaces</li>
		<li IfModActive="void.charactereditor, void.charactereditor.unofficial">1.6/Mods/CharacterEditor</li>
		<li IfModActive="tachyonite.pawnmorpherpublic">1.6/Mods/Pawnmorpher</li>
		<li IfModActive="LovelyDovey.Sex.WithEuterpe">Common/Mods/Intimacy</li>
	</v1.6>
	<v1.7>
		<li>Common</li>
		<li>1.7</li>
		<li IfModActive="Ludeon.RimWorld.Ideology">Common/Mods/Ideology</li>
		<li IfModActive="erdelf.HumanoidAlienRaces">Common/Mods/HumanoidAlienRaces</li>
		<li IfModActive="erdelf.HumanoidAlienRaces">1.7/Mods/HumanoidAlienRaces</li>
		<li IfModActive="void.charactereditor, void.charactereditor.unofficial">1.7/Mods/CharacterEditor</li>
		<li IfModActive="tachyonite.pawnmorpherpublic">1.7/Mods/Pawnmorpher</li>
		<li IfModActive="LovelyDovey.Sex.WithEuterpe">Common/Mods/Intimacy</li>
	</v1.7>
</loadFolders>
